-- TEMPLATE, not a migration: how to schedule a worker with Supabase Cron. Copy a block into a migration (or run it
-- via apply_migration) once the Edge Function is deployed. pg_cron, pg_net and the Vault secret come from
-- 20261102130000_worker_runs.sql and 20261102130100_worker_secret.sql.
--
-- pg_cron (1.5+, as on Supabase) accepts '<n> seconds' for sub-minute schedules (1-59 s), or a normal cron string.
-- The secret is read from the Vault at each tick, so it never appears in this file, the job's text, or the repo.
-- verify_jwt = false for both functions (supabase/config.toml), so no Authorization header is needed.
-- cron.schedule with an existing job name replaces that job.

-- Every 10 s: the live leaderboard (body {} = leaderboard).
select cron.schedule(
  'poll-tour',
  '10 seconds',
  $$
  select net.http_post(
    url := 'https://rihtmjtzrufkravyunuq.supabase.co/functions/v1/poll-tour',
    headers := jsonb_build_object(
      'content-type', 'application/json',
      'x-worker-secret', (select decrypted_secret from vault.decrypted_secrets where name = 'worker_secret')
    ),
    body := '{}'::jsonb,
    timeout_milliseconds := 9000
  );
  $$
);

-- Hourly, at minute 7: the world ranking.
select cron.schedule(
  'poll-rankings',
  '7 * * * *',
  $$
  select net.http_post(
    url := 'https://rihtmjtzrufkravyunuq.supabase.co/functions/v1/poll-tour',
    headers := jsonb_build_object(
      'content-type', 'application/json',
      'x-worker-secret', (select decrypted_secret from vault.decrypted_secrets where name = 'worker_secret')
    ),
    body := '{"part":"rankings"}'::jsonb,
    timeout_milliseconds := 15000
  );
  $$
);

-- Every 30 s: flights around the followed airports.
select cron.schedule(
  'poll-flights',
  '30 seconds',
  $$
  select net.http_post(
    url := 'https://rihtmjtzrufkravyunuq.supabase.co/functions/v1/poll-flights',
    headers := jsonb_build_object(
      'content-type', 'application/json',
      'x-worker-secret', (select decrypted_secret from vault.decrypted_secrets where name = 'worker_secret')
    ),
    body := '{}'::jsonb,
    timeout_milliseconds := 20000
  );
  $$
);

